# Copie para .env e preencha.
# O motor rota automaticamente entre TODAS as chaves numeradas que encontrar.
# Basta ir acrescentando _2, _3, ... que ele detecta sozinho.

GEMINI_API_KEY=
GEMINI_API_KEY_2=
GEMINI_API_KEY_3=
GEMINI_API_KEY_4=
GEMINI_API_KEY_5=
GEMINI_API_KEY_6=
GEMINI_API_KEY_7=
GEMINI_API_KEY_8=

GROQ_API_KEY=
GROQ_API_KEY_2=
GROQ_API_KEY_3=
GROQ_API_KEY_4=
GROQ_API_KEY_5=
GROQ_API_KEY_6=
GROQ_API_KEY_7=
GROQ_API_KEY_8=

# YouTube Data API v3 — usada por descobrir.py pra achar vídeos candidatos.
# console.cloud.google.com -> ativar "YouTube Data API v3" -> criar chave.
YOUTUBE_API_KEY=

# Personal Access Token do GitHub — só pra processar_lista.py disparar o
# corte na nuvem sozinho (workflow cortar_de_bruto.yml). Permissões:
# Actions (Read and write) no repositório Modo-Futuro. Fine-grained,
# github.com -> Settings -> Developer settings -> Personal access tokens.
GITHUB_TOKEN=
